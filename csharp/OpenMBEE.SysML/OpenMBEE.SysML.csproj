<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenMBEE.SysML</RootNamespace>
    <Description>Spec-shaped SysML v2 SDK: generated metaclass surface over the SysML Toolkit, or over interchange payloads</Description>
    <Version>0.2.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>SysML;SysMLv2;KerML;MBSE</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- The binding library per platform, and the notices of what it compiles in, when
       tools/package.py stages them here for a release package. -->
  <ItemGroup>
    <None Include="runtimes\**\*" Pack="true" PackagePath="runtimes\" />
    <None Include="THIRD-PARTY\**\*" Pack="true" PackagePath="THIRD-PARTY\" />
  </ItemGroup>

  <!-- The standard library models, when tools/package.py stages them here for a release package:
       embedded (StandardLibrary copies them out), their LICENSE and NOTICE also beside the package's.
       The models are under the Eclipse Public License 2.0, so the package's license is both. -->
  <ItemGroup>
    <EmbeddedResource Include="stdlib\**\*" LogicalName="stdlib/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="stdlib\LICENSE;stdlib\NOTICE" Pack="true" PackagePath="stdlib\" Condition="Exists('stdlib')" />
  </ItemGroup>
  <!-- The Pilot engine (sysml-pilot-server.jar), when tools/package.py stages it here: embedded, and
       copied out by PilotBackend to run in a Java process. -->
  <ItemGroup>
    <EmbeddedResource Include="pilot\sysml-pilot-server.jar" LogicalName="pilot/sysml-pilot-server.jar" Condition="Exists('pilot\sysml-pilot-server.jar')" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('stdlib')">
    <PackageLicenseExpression>Apache-2.0 AND EPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

</Project>
